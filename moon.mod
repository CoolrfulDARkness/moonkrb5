name = "CoolrfulDARkness/moonkrb5"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/CoolrfulDARkness/moonkrb5"

license = "Apache-2.0"

keywords = [
  "kerberos",
  "krb5",
  "asn1",
  "der",
  "crypto",
  "rfc4120",
  "rfc3961",
  "rfc3962",
  "rfc8009",
  "sans-io",
]

preferred_target = "wasm-gc"

description = "Pure MoonBit, zero-FFI, Sans-I/O Kerberos 5 authentication protocol stack (RFC 4120 / RFC 3961 / RFC 3962 / RFC 8009)"
